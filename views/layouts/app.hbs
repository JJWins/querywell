<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{default title "Querywell"}}</title>
  <link rel="icon" type="image/png" href="/QueryWell_Logo.png">
  <meta name="theme-color" content="#0870fd">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/app.css?v=studio4">
</head>
<body class="app-body" data-page="{{default page (default activeTab 'ask')}}">
  <header class="app-header">
    <div class="wrap app-header-inner">
      <div class="app-header-left">
        <a href="/ask" class="brand-link" aria-label="QueryWell home">
          {{> brand-logo className="brand-logo-app"}}
        </a>

        <div class="header-divider"></div>

        <div class="workspace-name" id="account-workspace">{{default account.workspaceName "Workspace"}}</div>
      </div>

      <div class="app-header-right">
        <span id="who" hidden></span>
        <span class="user-email" id="account-email">{{default account.email ""}}</span>
        <button id="sign-out" class="button button-sm ghost">Sign out</button>
      </div>
    </div>
  </header>

  {{> app-nav}}

  <main class="app-main">
    <div class="wrap">
      {{{body}}}
    </div>
  </main>

  <div id="toast-container" class="toast-container" aria-live="polite"></div>

  <script type="module" src="/app.js?v=studio4"></script>
</body>
</html>
