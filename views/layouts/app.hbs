<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{default title "AskMySQL Studio"}}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/app.css">
</head>
<body class="app-body" data-page="{{default page (default activeTab 'ask')}}">
  <header class="app-header">
    <div class="wrap app-header-inner">
      <div class="app-header-left">
        <a href="/ask" class="brand-link" aria-label="AskMySQL Home">
          <span class="brand-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <ellipse cx="12" cy="5" rx="9" ry="3"></ellipse>
              <path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"></path>
              <path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"></path>
            </svg>
          </span>
          <span class="brand-name">AskMySQL</span>
        </a>

        <div class="header-divider"></div>

        <div class="workspace-pill">
          <span class="workspace-icon">🏢</span>
          <span class="workspace-name" id="account-workspace">{{default account.workspaceName "Workspace"}}</span>
        </div>

        {{#if connection}}
          <div class="conn-pill conn-active" title="Connected to {{default connection.database connection.databaseName}} on {{connection.host}}">
            <span class="conn-dot"></span>
            <span class="conn-label"><code>{{connection.username}}@{{connection.host}}:{{connection.port}}/{{default connection.database connection.databaseName}}</code></span>
          </div>
        {{else}}
          <a href="/connect" class="conn-pill conn-disconnected" title="Connect your MySQL database">
            <span class="conn-dot"></span>
            <span class="conn-label">No database connected</span>
          </a>
        {{/if}}
      </div>

      <div class="app-header-right">
        <span id="who" hidden></span>
        <span class="user-email" id="account-email">{{default account.email ""}}</span>
        <button id="sign-out" class="button button-sm ghost">Sign out</button>
      </div>
    </div>
  </header>

  {{> app-nav}}

  <main class="app-main">
    <div class="wrap">
      {{{body}}}
    </div>
  </main>

  <div id="toast-container" class="toast-container" aria-live="polite"></div>

  <script type="module" src="/app.js"></script>
</body>
</html>
