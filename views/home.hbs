<!-- Technical Architecture & Security -->
<section id="architecture" class="section-container">
  <div class="wrap">
    <div class="section-header">
      <span class="section-kicker">Architecture &amp; Reliability</span>
      <h2 class="section-title">Designed for Enterprise Security &amp; Accuracy</h2>
      <p class="section-desc">
        We solved the two biggest problems in NL-to-SQL: catastrophic hallucinations on massive schemas, and unauthorized write privileges.
      </p>
    </div>

    <div class="feature-grid">
      <div class="feature-card">
        <div class="feature-icon">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
          </svg>
        </div>
        <h3 class="feature-title">Strict Read-Only User Probe</h3>
        <p class="feature-text">
          Before a connection is saved, Querywell tests that the database user cannot write. <code>INSERT</code>, <code>UPDATE</code>, <code>DELETE</code>, and <code>DROP</code> privileges are rejected immediately.
        </p>
        <div class="code-snippet-small">
          <code>CREATE USER 'nlq_ro'@'%' IDENTIFIED BY '...';<br>GRANT SELECT ON db.* TO 'nlq_ro'@'%';</code>
        </div>
      </div>

      <div class="feature-card">
        <div class="feature-icon">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"></circle>
            <polyline points="12 6 12 12 14 14"></polyline>
          </svg>
        </div>
        <h3 class="feature-title">Dual-Engine Schema Routing</h3>
        <p class="feature-text">
          Databases under 30k characters receive full-context reasoning across all tables for flawless multi-table joins. Large schemas (>30k characters) use Qdrant vector retrieval to dynamically inject only the relevant tables.
        </p>
        <ul class="feature-bullets">
          <li><strong>Small Path (&le;30k chars):</strong> Global foreign-key inference</li>
          <li><strong>Large Path (&gt;30k chars):</strong> Cosine vector table retrieval</li>
        </ul>
      </div>

      <div class="feature-card">
        <div class="feature-icon">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
            <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
          </svg>
        </div>
        <h3 class="feature-title">AES-256-GCM Credential Vault</h3>
        <p class="feature-text">
          Database passwords are encrypted using authenticated AES-256-GCM before reaching disk. Decryption happens solely in memory during authorized query execution and is immediately garbage-collected.
        </p>
        <ul class="feature-bullets">
          <li>Zero persistent plaintext credentials</li>
          <li>Automatic rotation ready</li>
        </ul>
      </div>
    </div>
  </div>
</section>

<!-- How It Works 3-Step Flow -->
<section id="how-it-works" class="section-container bg-subtle">
