<div class="auth-page-wrapper">
  <div class="auth-card">
    <div class="auth-header">
      <div class="auth-brand-badge">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <ellipse cx="12" cy="5" rx="9" ry="3"></ellipse>
          <path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"></path>
          <path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"></path>
        </svg>
      </div>
      <h1 class="auth-title">Sign in to Querywell</h1>
      <p class="auth-subtitle">Open your workspace, database, and SQL studio.</p>
    </div>

    <form id="signin-form" class="auth-form" novalidate>
      <div id="error" class="form-error" hidden></div>

      <div class="form-group">
        <label for="email" class="form-label">Work Email</label>
        <input 
          id="email" 
          name="email" 
          type="email" 
          class="form-input" 
          placeholder="name@company.com" 
          autocomplete="email" 
          required 
          autofocus
        >
      </div>

      <div class="form-group">
        <div class="label-row">
          <label for="password" class="form-label">Password</label>
        </div>
        <input 
          id="password" 
          name="password" 
          type="password" 
          class="form-input" 
          placeholder="••••••••••••" 
          autocomplete="current-password" 
          required
        >
      </div>

      <div class="form-actions">
        <button type="submit" class="button button-block primary">Sign In &rarr;</button>
      </div>
    </form>

    <div class="auth-footer">
      <span>Don't have a workspace?</span>
      <a href="/signup" class="auth-link">Start 30-Question Trial</a>
    </div>

    <div class="auth-security-note">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
      <span>Enforced Read-Only Engine &bull; AES-256 Vault</span>
    </div>
  </div>
</div>
