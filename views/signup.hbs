<div class="auth-page-wrapper">
  <div class="auth-card">
    <div class="auth-header">
      {{> brand-logo className="brand-logo-auth"}}
      <h1 class="auth-title">Create Your Workspace</h1>
      <p class="auth-subtitle">14-day trial: 30 questions, one database, no credit card.</p>
    </div>

    <form id="signup-form" class="auth-form" novalidate>
      <div id="error" class="form-error" hidden></div>

      <div class="form-group">
        <label for="workspace-name" class="form-label">Workspace Name</label>
        <input 
          id="workspace-name" 
          name="workspaceName" 
          type="text" 
          class="form-input" 
          placeholder="Acme Analytics" 
          required 
          autofocus
        >
        <span class="form-hint">Usually your organization or team name.</span>
      </div>

      <div class="form-group">
        <label for="email" class="form-label">Work Email</label>
        <input 
          id="email" 
          name="email" 
          type="email" 
          class="form-input" 
          placeholder="name@company.com" 
          autocomplete="email" 
          required
        >
      </div>

      <div class="form-group">
        <label for="password" class="form-label">Password</label>
        <input 
          id="password" 
          name="password" 
          type="password" 
          class="form-input" 
          placeholder="At least 8 characters" 
          autocomplete="new-password" 
          required 
          minlength="8"
        >
      </div>

      <div class="form-actions">
        <button type="submit" class="button button-block primary">Create Workspace</button>
      </div>
    </form>

    <div class="auth-footer">
      <span>Already have an account?</span>
      <a href="/signin" class="auth-link">Sign in</a>
    </div>

    <div class="auth-security-note">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
      <span>14 days &bull; 30 questions &bull; 1 database &bull; No credit card</span>
    </div>
  </div>
</div>
