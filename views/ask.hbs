<div class="studio">
  <div id="error" class="studio-banner" hidden></div>

  <div id="need-connect" class="studio-canvas studio-empty {{#if connection}}hidden{{/if}}" {{#if connection}}hidden{{/if}}>
    <div class="studio-empty-copy">
      <h1 class="studio-empty-title">Connect a database first</h1>
      <p class="studio-empty-text">SQL Studio asks this workspace’s indexed replica. Connect one on Database Source.</p>
      <a href="/connect" class="button primary">Connect database</a>
    </div>
  </div>

  <div id="studio-workspace" class="studio-workspace" {{#unless connection}}hidden{{/unless}}>
    <div class="studio-toolbar">
      {{#if connection}}
        <div class="studio-db" title="{{connection.host}}:{{connection.port}}">
          <span class="status-indicator-dot online"></span>
          <strong>{{default connection.database connection.databaseName}}</strong>
        </div>
      {{else}}
        <div class="studio-db">No database</div>
      {{/if}}

      {{#if (gt sqlProviders.length 1)}}
        <label class="model-picker" for="sql-provider">
          <span>Model</span>
          <select id="sql-provider" name="provider">
            {{#each sqlProviders}}
              <option value="{{id}}" {{#if selected}}selected{{/if}}>{{label}}</option>
            {{/each}}
          </select>
        </label>
      {{/if}}
    </div>

    <div class="studio-canvas" id="studio-canvas">
      <div id="studio-empty" class="studio-empty">
        <div class="studio-empty-copy">
          <h1 class="studio-empty-title">Ask this database</h1>
          <p class="studio-empty-text">Type a question below, or start with one of these.</p>
        </div>
        <div class="studio-suggestions">
          <button type="button" class="studio-suggestion" data-prompt="How many orders have a paid status?">How many orders have a paid status?</button>
          <button type="button" class="studio-suggestion" data-prompt="Which 5 customers generated the highest total revenue this quarter?">Top 5 customers by revenue</button>
          <button type="button" class="studio-suggestion" data-prompt="List 5 most recent orders with status">Most recent orders</button>
          <button type="button" class="studio-suggestion" data-prompt="Count all customers and orders">Count customers and orders</button>
        </div>
      </div>

      <p id="ask-status" class="studio-asking" hidden>Asking…</p>
      <div id="answer" class="studio-answer" hidden></div>
    </div>

    <form id="ask-form" class="studio-composer" novalidate>
      <textarea
        id="question"
        name="question"
        rows="1"
        aria-label="Question"
        placeholder="Ask a question about this database"
        required
      ></textarea>
      <button id="ask-submit" type="submit" class="button primary">Ask</button>
    </form>
  </div>
</div>
