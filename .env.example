APP_PORT=3000

# App catalog. This is the product database, not a customer's database.
CATALOG_DB_HOST=127.0.0.1
CATALOG_DB_PORT=3306
CATALOG_DB_USER=
CATALOG_DB_PASSWORD=
CATALOG_DB_NAME=nlp_saas

# 32-byte key, base64. Used to encrypt customer database passwords.
APP_ENCRYPTION_KEY=

# Vectors. Collections are created by this app and filtered by workspace id.
QDRANT_URL=http://127.0.0.1:6333

# Same HTTP embedding service the reference demo uses.
EMBEDDING_URL=http://192.168.1.235:11435/api/embed
EMBEDDING_MODEL=qwen3-embedding:latest
EMBEDDING_DIM=1024
EMBED_TIMEOUT_MS=120000
EMBED_KEEP_ALIVE=-1
EMBED_CONCURRENCY=8

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Stripe. Price ids are the prices for Starter, Growth, and Scale.
# Checkout offers only the price that matches the measured schema.
APP_BASE_URL=http://127.0.0.1:3000
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_SCALE=

RESULT_LIMIT=100
RETRIEVE_LIMIT=10
FEWSHOT_LIMIT=4
